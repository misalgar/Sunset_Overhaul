# Keep source and Gradle scripts LF so the wrapper stays runnable on macOS/Linux.
* text=auto eol=lf

# Windows-only launchers keep CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets must never be converted or diffed as text.
*.png binary
*.jpg binary
*.webp binary
*.mp4 binary
*.ttf binary
*.jar binary
