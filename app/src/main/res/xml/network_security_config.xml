<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is denied everywhere except the approved provider host, which serves the Xtream Codes
  API and MPEG-TS streams over plain HTTP. Any other host must use HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">play.pelusa.online</domain>
    </domain-config>
</network-security-config>
